    "document": {
        "name": "Hebrew Alphabet Chart",
        "types" : {
            "1" : {
                "name": "Proto-Sinaitic",
                "period": "c. 1850-1500 BCE",
                "description": "The earliest \"pictographic\" alphabet where Alef looks like a literal ox head and Bet looks like a house floor plan."
            },
            "2":{
                "name": "Paleo-Hebrew / Phoenician",
                "period": "c. 1000 BCE",
                "description": "The pictograms became abstracted into a sharp, linear script."
            },
            "3":{
                "name": "Square Hebrew",
                "period": "c. 500 BCE-Present",
                "description": "Adopted from the Aramaic script, which eventually became modern Hebrew."
            }
        },
